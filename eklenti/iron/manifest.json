{
  "manifest_version": 3,
  "name": "Akcan — tedarikçi fiyat yardımcısı",
  "version": "1.9.6",
  "description": "Iron Otomotiv, Başbuğ, Özaş ve Dinamik (Ada Oto) B2B'de (aynı B2B yazılımı) yaptığınız aramaların fiyatlarını Akcan'a kaydeder; BizimHesap'ta tedarikçide zamlanan ürünlerin kart alış fiyatını, sizin onayınızla BizimHesap'ın kendi Toplu Ürün Güncelleme özelliğiyle günceller. Ödeal e-Fatura portalında açtığınız fatura listesini (yalnız fatura başlıkları) Akcan'a kaydeder. Sepete eklemez, sipariş vermez.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://qmafuyuocmcobrstnmbx.supabase.co/*"
  ],
  "background": {
    "service_worker": "arka.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Akcan — tedarikçi fiyat yardımcısı",
    "default_icon": {
      "16": "ikon16.png",
      "48": "ikon48.png",
      "128": "ikon128.png"
    }
  },
  "icons": {
    "16": "ikon16.png",
    "48": "ikon48.png",
    "128": "ikon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://b2b.ironotomotiv.com/*",
        "https://b2bbasbug.com/*",
        "https://program.ozas.com.tr/*",
        "https://bayi.adaoto.com.tr/*",
        "https://online.ozcete.com.tr/*",
        "https://online.martas.com.tr/*",
        "https://b2b.otoismail.com.tr/*",
        "https://b4b.neko.com.tr/*",
        "https://b4b.otomarmara.com.tr/*"
      ],
      "js": [
        "sayfa.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://b2b.ironotomotiv.com/*",
        "https://b2bbasbug.com/*",
        "https://program.ozas.com.tr/*",
        "https://bayi.adaoto.com.tr/*",
        "https://online.ozcete.com.tr/*",
        "https://online.martas.com.tr/*",
        "https://b2b.otoismail.com.tr/*",
        "https://b4b.neko.com.tr/*",
        "https://b4b.otomarmara.com.tr/*"
      ],
      "js": [
        "icerik.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://fatura.odeal.com/*"
      ],
      "js": [
        "odeal-sayfa.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://fatura.odeal.com/*"
      ],
      "js": [
        "odeal-icerik.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://uygulama.bizimhesap.com/web/*"
      ],
      "js": [
        "bh.js"
      ],
      "run_at": "document_idle"
    }
  ]
}