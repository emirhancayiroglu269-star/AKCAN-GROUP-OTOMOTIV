{
  "manifest_version": 3,
  "name": "Akcan — tedarikçi fiyat yardımcısı",
  "version": "1.7.0",
  "description": "Iron Otomotiv, Başbuğ ve Özaş B2B'de (aynı B2B yazılımı) yaptığınız aramaların fiyatlarını Akcan'a kaydeder; BizimHesap'ta tedarikçide zamlanan ürünlerin kart alış fiyatını, sizin onayınızla BizimHesap'ın kendi Toplu Ürün Güncelleme özelliğiyle günceller. Sepete eklemez, sipariş vermez.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://qmafuyuocmcobrstnmbx.supabase.co/*"
  ],
  "background": {
    "service_worker": "arka.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Akcan — tedarikçi fiyat yardımcısı",
    "default_icon": {
      "16": "ikon16.png",
      "48": "ikon48.png",
      "128": "ikon128.png"
    }
  },
  "icons": {
    "16": "ikon16.png",
    "48": "ikon48.png",
    "128": "ikon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://b2b.ironotomotiv.com/*",
        "https://b2bbasbug.com/*",
        "https://program.ozas.com.tr/*"
      ],
      "js": [
        "sayfa.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://b2b.ironotomotiv.com/*",
        "https://b2bbasbug.com/*",
        "https://program.ozas.com.tr/*"
      ],
      "js": [
        "icerik.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://uygulama.bizimhesap.com/web/*"
      ],
      "js": [
        "bh.js"
      ],
      "run_at": "document_idle"
    }
  ]
}