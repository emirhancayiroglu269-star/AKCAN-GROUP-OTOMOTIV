# Merkezi veri sunucusu (Supabase).
# Bu dosyayı `.env` olarak kopyalayıp gerçek değerleri girin.
# .env dosyası .gitignore'da — asla commit edilmez.
#
# Project URL: Supabase Dashboard → Project Settings → API → Project URL
# Publishable key: aynı sayfadaki "anon / publishable" anahtarı.
#   Service role anahtarı BURAYA YAZILMAZ — tarayıcıya giden koda girmemeli.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
